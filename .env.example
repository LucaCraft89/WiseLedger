# Copy to .env (git-ignored). Placeholders only here: never a seed, mnemonic or key.

# Local AI: qvac | openai (qvac serve --openai on localhost) | mock
LLM_PROVIDER=qvac
QVAC_CONFIG_PATH=./qvac.config.json
# Model constant in @qvac/sdk; empty = QWEN3_5_2B_MULTIMODAL_Q4_K_M (small-RAM machines: QWEN3_5_0_8B_MULTIMODAL_Q4_K_M)
QVAC_MODEL=
# URL of a local `qvac serve --openai` (only with LLM_PROVIDER=openai)
OPENAI_COMPAT_BASE_URL=

# Wallet: mock | wdk-rgb | rgb-lib
WALLET_BACKEND=wdk-rgb
# Network: mutinynet (signet + KaleidoSwap endpoints) | regtest
RGB_NETWORK=mutinynet
WALLET_DATA_DIR=.data/wallet
PAYEE_DATA_DIR=.data/payee
# Always explicit (the wdk-wallet-rgb defaults for 'signet' do not work)
RGB_INDEXER_URL=https://esplora.signet.kaleidoswap.com
RGB_TRANSPORT_ENDPOINT=rpcs://proxy.kaleidoswap.com/json-rpc
# RGB proxy servers a payment request may use without a warning (comma-separated; empty = RGB_TRANSPORT_ENDPOINT)
RGB_TRANSPORT_ALLOWLIST=
RGB_EXPLORER_URL=https://mutinynet.com

# Test asset and limits (base units, precision 6)
ASSET_ALLOWLIST=
PAYMENT_CAP=100000000
# Max per asset in any 24 h, base units (default 5 × PAYMENT_CAP)
DAILY_CAP=

# PDF rendering for demo:prepare (optional: system Chromium on Fedora)
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Lightning (separate data dir). LN_ENABLED=true: `pnpm dev` also starts our LSP (node A, .data/ln/a) and the
# server's node (.data/ln/c) gets its channel from it. Needs the RGB Lightning module (LN_MODULES, docs/decisions/a-003).
LN_ENABLED=false
LN_DATA_DIR=.data/ln
# Our own LSP from `pnpm dev` (the UTEXO LSP is not on Mutinynet)
LN_LSP_URL=http://127.0.0.1:8790
LN_PEER_PORT=9737

# Wallet fee rate in sat/vB, always passed explicitly (the estimate is 0 on Mutinynet)
RGB_FEE_RATE=2
WALLET_SEND_TIMEOUT_MS=120000
# Background wallet sync (ms): fast while a payment or a "Get paid" request is pending, slow when idle
# (each sync blocks the server for 1–5 s on Mutinynet).
WALLET_SYNC_MS=15000
WALLET_SYNC_IDLE_MS=60000
