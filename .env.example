# Copy to .env (git-ignored). Placeholders only here: never a seed, mnemonic or key.

# Local AI: qvac | openai (qvac serve --openai on localhost) | mock
LLM_PROVIDER=mock
QVAC_CONFIG_PATH=./qvac.config.json
# Model constant in @qvac/sdk (Qwen3.5-2B Q4; exact name fixed in docs/decisions/b-001-qvac.md)
QVAC_MODEL=
# URL of a local `qvac serve --openai` (only with LLM_PROVIDER=openai)
OPENAI_COMPAT_BASE_URL=

# Wallet: mock | wdk-rgb | rgb-lib
WALLET_BACKEND=mock
# Network: mutinynet (signet + KaleidoSwap endpoints) | regtest
RGB_NETWORK=mutinynet
WALLET_DATA_DIR=.data/wallet
PAYEE_DATA_DIR=.data/payee
# Always explicit (the wdk-wallet-rgb defaults for 'signet' do not work)
RGB_INDEXER_URL=https://esplora.signet.kaleidoswap.com
RGB_TRANSPORT_ENDPOINT=rpcs://proxy.kaleidoswap.com/json-rpc
RGB_EXPLORER_URL=https://mutinynet.com

# Test asset and limits (base units, precision 6)
ASSET_ALLOWLIST=
PAYMENT_CAP=100000000

# PDF rendering for demo:prepare (optional: system Chromium on Fedora)
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Lightning (extra, separate data dir)
LN_ENABLED=false
LN_DATA_DIR=.data/ln
# The UTEXO LSP works on the UTEXO signet, not on Mutinynet: only with mentors' confirmation
LN_LSP_URL=

# Wallet fee rate in sat/vB, always passed explicitly (the estimate is 0 on Mutinynet)
RGB_FEE_RATE=2
