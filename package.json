{
  "name": "wiseledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.17 <23"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm secret-scan",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --if-present run test && bash scripts/secret-scan.test.sh",
    "secret-scan": "bash scripts/secret-scan.sh",
    "dev": "pnpm --parallel -F server -F web -F wallet --if-present run dev",
    "demo:mock": "pnpm -F server --if-present run demo:mock",
    "wallet:smoke": "pnpm -F wallet --if-present run smoke",
    "demo:prepare": "pnpm -F wallet --if-present run demo:prepare",
    "demo:reset": "pnpm -F wallet --if-present run demo:reset",
    "evals": "pnpm -F ai --if-present run evals",
    "regtest": "bash infra/regtest/regtest.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
